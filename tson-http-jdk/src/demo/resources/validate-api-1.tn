!!id:"https://schemas.example.com/2026/34/app/validate-api-1.tn"
!!meta:"https://tson.io/2026/34/ltr8/http/meta-http-1.tn"
!!import:"https://schemas.example.com/2026/34/app/validate-1.tn"
!!import:"https://tson.io/2026/34/ltr8/http/problem-1.tn"
!!import:"https://tson.io/2026/34/m/core.tn"
{
  @doc:"""
    Check a document against a schema and report every problem in one pass.

    The status is 200 for a document that does not conform, which reads wrong for about a second and
    is right: the request was well-formed and the service answered it. The diagnostics ARE the
    answer. A 400 here is always about the envelope -- a body that is not a valid validation_request
    -- and never about the document under test, which would otherwise make a client unable to tell
    "you asked badly" from "the thing you asked about is bad".
    """
  validate => !operation {
    method:      POST
    path:        "/validate"
    summary:     "Validate a document against a schema"
    request:     validation_request
    responses:   [
      !response { status: 200  body: validation_result
                  description: "The verdict, conforming or not" }
      !response { status: 400  body: problem
                  description: "The request body is not a valid validation_request" }
    ]
  }

  @doc:"The page itself: two editors, the scenarios, and the diagnostics."
  get_page => !operation {
    method:      GET
    path:        "/"
    summary:     "The validator page"
    responses:   [
      !response { status: 200  description: "The page, served as bytes" }
    ]
  }

  @doc:"Every schema this service names is served at its own identity's path."
  get_schema => !operation {
    method:      GET
    path:        "/{schemaPath}"
    summary:     "Fetch a published schema"
    parameters:  [
      !parameter { name: "schemaPath"  in: PATH  type: text  required: true
                   description: "The path component of the schema's own !!id" }
    ]
    responses:   [
      !response { status: 200  description: "The schema document, served as bytes" }
      !response { status: 404  body: problem
                  description: "No schema is published there" }
    ]
  }
}
