!!id:"https://schemas.example.com/2026/38/app/validate-api-1.tn"
!!meta:"https://tson.io/2026/38/io/ltr8/http/meta-service.tn"
!!import:"https://schemas.example.com/2026/38/app/validate-1.tn"
!!import:"https://tson.io/2026/38/io/ltr8/http/problem.tn"
!!import:"https://tson.io/2026/38/io/ltr8/http/deployment.tn"
!!import:"https://tson.io/2026/38/m/core.tn"
{
  @doc:"Where a published schema is: the path component of its own !!id."
  schema_ref => { schemaPath: text }

  validator => !api {
    "/validate" => {
      @summary:"Validate a document against a schema"
      @doc:"""
        Check a document against a schema and report every problem in one pass.

        The status is 200 for a document that does not conform, which reads wrong for about a second and
        is right: the request was well-formed and the service answered it. The diagnostics ARE the
        answer. A 400 here is always about the envelope -- a body that is not a valid validation_request
        -- and never about the document under test, which would otherwise make a client unable to tell
        "you asked badly" from "the thing you asked about is bad".
        """
      POST => !operation { request: validation_request  response: validation_result }
    }

    "/" => {
      @safe
      @summary:"The validator page"
      @doc:"The page itself: two editors, the scenarios, and the diagnostics."
      GET => !document { media_type: "text/html" }
    }

    "/.well-known/tson-deployment" => {
      @safe
      @summary:"What this deployment will accept"
      @doc:"""
        What this deployment will accept, as a projection of its descriptor.

        A well-known path rather than an identity's, and the reason is the reason the descriptor exists: in this
        series everything with an identity is served at its identity's path (§2.2.1), and a deployment descriptor
        is precisely the artifact that must NOT have an identity -- so a well-known path is right for it for the
        same reason it would be wrong for a schema.

        What is served is DERIVED from the descriptor, never the descriptor: the fetch allow-list is internal
        topology. And it is a hint -- it can be cached, and only the refusal a request actually receives says
        what applied to that request.
        """
      GET => !operation { response: acceptance_profile }
    }

    "/{+schemaPath}" => {
      @safe
      @summary:"Fetch a published schema"
      @doc:"Every schema this service names is served at its own identity's path."
      GET => !document { request: schema_ref  media_type: "application/tson" }
    }
  }
}
