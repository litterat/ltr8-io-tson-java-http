!!id:"https://schemas.example.com/2026/40/orders/orders-1.tn"
!!import:"https://tson.io/2026/40/io/ltr8/http/service.tn"
!!import:"https://schemas.example.com/2026/40/orders/orders-types-1.tn"
!!import:"https://schemas.example.com/2026/40/orders/orders-errors-1.tn"
@doc:"""
  Protocol only: nothing HTTP in the document. A protocol is an entry applying `service.protocol`, a record
  whose `exchanges` maps exchange names to exchanges -- an exchange's name is the key it sits under, scoped to
  its protocol, and a `@doc` before the key documents it. The `!service.exchange` tag is optional under the
  typed slot. An exchange's qualified name is the protocol's entry, its `exchanges` field and then its key
  (`orders.exchanges.place_order`). The facts an exchange states about itself are bare markers before its key:
  `cancel_order` is idempotent and destructive, so a caller may retry it and should confirm it first. A protocol
  lists its exchanges and nothing more: `orders_v2` declares only what it adds, and an http projection offering
  both binds both.
  """
!schema {
  @doc:"The orders protocol."
  orders => !service.protocol {
    exchanges: {
      @service.summary:"Place an order."
      @doc:"Accept an order and confirm it with the quantity doubled."
      place_order  => { request: new_order    response: order       errors: [sku_not_found] }
      @service.safe
      @doc:"One order, by reference."
      get_order    => { request: order_ref    response: order       errors: [order_not_found] }
      @service.safe
      @doc:"A page of orders, filtered by status."
      list_orders  => { request: order_query  response: order_page }
      @service.idempotent
      @service.destructive
      @doc:"Cancel an order. Cancelling twice is the same as cancelling once, and a cancelled order stays cancelled."
      cancel_order => { request: order_ref    errors: [order_not_found] }
    }
  }

  @doc:"Refunds, offered beside orders."
  orders_v2 => !service.protocol {
    exchanges: {
      @service.idempotent
      refund => { request: order_ref }
    }
  }
}
