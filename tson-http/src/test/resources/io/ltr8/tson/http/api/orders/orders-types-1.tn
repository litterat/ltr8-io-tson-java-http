!!id:"https://schemas.example.com/2026/39/orders/orders-types-1.tn"
!!import:"https://tson.io/2026/39/m/core.tn"
@doc:"""
  The types the orders examples share. Every exchange takes exactly one request record, which is what lets
  a binding distribute its fields over the HTTP request -- so a parameter-only endpoint has a one-field
  record here too (`order_ref`) rather than a parameter list anywhere else.
  """
!schema {
  order       => { sku: text  quantity: int32 }
  order_ref   => { id: text }
  order_query => { status?: text  page?: int32 ~ 1  page_size?: int32 ~ 20 }
  order_page  => { items: [order]  next_page?: int32 }
  new_order   => { order: order  idempotency_key?: text }
}
