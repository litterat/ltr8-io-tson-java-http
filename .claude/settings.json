      "Bash(git mv *)",
      "Bash(git rm *)",
      "Bash(git stash *)",
      "Bash(git -C ../ltr8-io-tson-java status *)",
      "Bash(git -C ../ltr8-io-tson-java log *)",
      "Bash(git -C ../ltr8-io-tson-java show *)",
      "Bash(git -C ../ltr8-io-tson-java diff *)",
      "Bash(git -C ../ltr8-io-tson-java branch *)",
      "Bash(git -C ../ltr8-io-tson-java rev-parse *)",
      "Bash(git -C ../ltr8-io-tson-java fetch *)",
      "Bash(git -C ../ltr8-io-tson-java pull *)",
      "Bash(git -C ../ltr8-io-tson-java checkout *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh run *)",
      "Bash(gh issue *)",
      "Bash(gh api *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed -n *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "WebFetch(domain:tson.io)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:www.rfc-editor.org)",
      "WebFetch(domain:datatracker.ietf.org)",
      "WebFetch(domain:docs.gradle.org)",
